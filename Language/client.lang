matchmaking.error.partyNotFound = [TMP] Nie udało się znaleźć twojej grupy.
matchmaking.error.rateLimited = [TMP] Dołączasz do kolejki zbyt szybko. Poczekaj chwilę i spróbuj ponownie.
matchmaking.error.rosterBusy = [TMP] Ty lub gracz w twojej grupie nadal jesteście w kolejce lub w meczu. Poczekaj chwilę i spróbuj ponownie.
matchmaking.error.playerBanned = [TMP] Masz blokadę na minigry za naruszenie Wytycznych dla społeczności. Możesz odwołać się na stronie accounts.hytale.com/appeals.
matchmaking.error.partyMemberBanned = [TMP] Gracz w twojej grupie ma blokadę na minigry. Usuń go z grupy, aby dołączyć do kolejki.
