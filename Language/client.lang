matchmaking.ended.unknown = [TMP] Twoja kolejka dobiegła końca. {leader, select, true {Możesz ponownie dołączyć do kolejki.} other {Poczekaj, aż lider grupy ponownie dołączy do kolejki.}}
matchmaking.ended.previousQueue = [TMP] Nadal byłeś w kolejce, gdy gra została zamknięta, więc kolejka została anulowana. Możesz ponownie dołączyć do kolejki.
matchmaking.ended.previousMatch = [TMP] Mecz z twojej ostatniej sesji wciąż się uruchamiał. Nie dołączyłeś do niego.
